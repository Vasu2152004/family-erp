{
    "$schema": "https://openai.vercel.sh/vercel.json",
    "outputDirectory": "public",
    "functions": {
        "api/lambda.php": {
            "runtime": "vercel-php@0.8.0"
        }
    },
    "rewrites": [
        {"source": "/(.*)", "destination": "/api/lambda.php?req_path=/$1"}
    ],
    "buildCommand": "composer run vercel"
}